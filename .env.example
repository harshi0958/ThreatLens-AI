APP_NAME=ThreatLens AI
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=threatlens
MONGODB_ALERTS_COLLECTION=alerts
MONGODB_ANALYSIS_COLLECTION=analysis_history
MONGODB_MODEL_COLLECTION=model_metadata
MONGODB_SETTINGS_COLLECTION=app_settings
DEMO_MODE=true
MAX_UPLOAD_SIZE_MB=10
MAX_ROWS_PER_UPLOAD=5000
BATCH_SIZE=50
DET_ALERT_THRESHOLD=0.5
DET_RISK_THRESHOLD=65
DET_PORTSCAN_THRESHOLD=0.6
DET_DOS_THRESHOLD=0.7
DET_ANOMALY_THRESHOLD=0.58
LOG_LEVEL=INFO
